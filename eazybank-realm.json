{
  "id": "eazybank",
  "realm": "eazybank",
  "displayName": "FinEase Banking Made Easy",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Full Administrative Control and Role Management"
      },
      {
        "name": "MANAGER",
        "description": "Branch Management and Loan Sanctions"
      },
      {
        "name": "CUSTOMER",
        "description": "Standard Retail Banking Customer"
      }
    ]
  },
  "defaultRoles": [
    "CUSTOMER"
  ],
  "clients": [
    {
      "clientId": "finease-ui",
      "name": "FinEase Angular Frontend",
      "description": "Public OIDC PKCE Client for Angular Single Page Application",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "http://localhost:4200",
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:4200"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/login##http://localhost:4200/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "mobileNumber",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "mobileNumber",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "mobileNumber",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "backend-admin-client",
      "name": "Spring Boot Backend Admin Client",
      "description": "Confidential client for microservices service-account integration",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "backend-admin-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
